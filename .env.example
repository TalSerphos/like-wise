# Copy to .env.local and fill in. Values marked (Phase N) are needed from that phase on.

# --- Supabase (Phase 0) -------------------------------------------------------
# Project Settings → API. The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- Claude (Phase 2) ---------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Google Maps Platform (Phase 1) -------------------------------------------
# Server key: Places API (New) + Geocoding. Restrict by API.
GOOGLE_MAPS_SERVER_KEY=
# Browser key: Maps JavaScript API. Restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- TripAdvisor Content API (Phase 1) ----------------------------------------
TRIPADVISOR_API_KEY=

# --- Review vendors (Phase 1) -------------------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional fallback vendor.
APIFY_TOKEN=

# --- Reddit (Phase 6, after access is approved) -------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=likewise/0.1 (by /u/your_username)

# --- Background jobs (Phase 3) ------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Analytics (Phase 4) ------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Guest abuse protection (Phase 4) -----------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Salt for hashing guest IPs before storing them.
GUEST_IP_SALT=

# --- Budget guard (Phase 3) ---------------------------------------------------
MONTHLY_BUDGET_USD=300
BUDGET_ALERT_EMAIL=
